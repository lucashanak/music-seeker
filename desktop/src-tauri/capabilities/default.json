{
  "identifier": "default",
  "description": "Allow IPC from the configured server and the bundled setup page",
  "windows": [
    "main",
    "setup"
  ],
  "remote": {
    "urls": [
      "https://musicseeker.hanaktech.org/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-install-macos-update",
    "allow-open-external",
    "allow-set-server-url",
    "allow-reset-server-url",
    "allow-current-server-url"
  ]
}
