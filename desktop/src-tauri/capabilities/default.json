{
  "identifier": "default",
  "description": "Allow IPC from the configured server and the bundled setup page",
  "windows": [
    "main",
    "setup"
  ],
  "remote": {
    "urls": [
      "https://musicseeker.hanaktech.org/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-install_macos_update",
    "allow-open_external",
    "allow-set_server_url",
    "allow-reset_server_url",
    "allow-current_server_url"
  ]
}
