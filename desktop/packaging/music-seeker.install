# pacman doesn't refresh the icon theme cache or desktop database on its own, so a
# freshly-installed launcher icon can fail to appear in the app menu until these run.
post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  post_install
}
